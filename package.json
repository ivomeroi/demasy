{
  "name": "demasy",
  "version": "1.0.0",
  "description": "DEMASY: prototipo académico offline-first para simulación, adquisición y análisis bilateral de señales EMG",
  "private": true,
  "main": "index.html",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "build": "echo 'No build process required for static app'",
    "test": "npm run lint && npm run test:unit && npm run smoke",
    "test:unit": "node --test tests/*.test.cjs",
    "lint": "node scripts/check-js.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:backup": "echo 'Open http://localhost:8000 and run: window.dbUtils.exportAllData() in browser console'",
    "db:clear": "echo 'Open http://localhost:8000 and run: window.dbUtils.clearSampleData() in browser console'", 
    "db:init": "echo 'Open http://localhost:8000 and run: window.dbUtils.initializeSampleData() in browser console'",
    "db:stats": "echo 'Open http://localhost:8000 and run: window.dbUtils.getDatabaseStats() in browser console'",
    "deploy": "bash ./deploy.sh",
    "predeploy": "npm test",
    "postdeploy": "echo 'Deployment completed! 🎉'"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ivomeroi/demasy.git"
  },
  "keywords": [
    "emg",
    "electromyography", 
    "kinesiology",
    "physical-therapy",
    "medical",
    "biomedical-engineering", 
    "esp32",
    "web-app",
    "real-time",
    "signal-processing",
    "ai-assistant",
    "healthcare",
    "rehabilitation",
    "patient-management",
    "indexeddb",
    "bilateral-analysis",
    "cycling-biomechanics",
    "database",
    "offline-first"
  ],
  "author": "ivomeroi",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/ivomeroi/demasy/issues"
  },
  "homepage": "https://github.com/ivomeroi/demasy#readme",
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "chart.js": "^3.9.1"
  },
  "devDependencies": {
    "serve": "^14.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions"
  ],
  "config": {
    "emg": {
      "sampleRate": 1000,
      "maxChannels": 8,
      "bufferSize": 10000
    }
  },
  "pwa": {
    "name": "DEMASY",
    "short_name": "DEMASY",
    "description": "Professional EMG Analysis Platform",
    "theme_color": "#2563eb",
    "background_color": "#ffffff",
    "display": "standalone",
    "orientation": "landscape-primary"
  },
  "hardware": {
    "esp32": {
      "supportedBoards": ["ESP32-WROOM-32", "ESP32-S3", "ESP32-C3"],
      "communicationMethods": ["Serial", "Bluetooth"],
      "sampleRateRange": [200, 500],
      "adcResolution": "12-bit",
      "inputChannels": 2
    }
  }
}
